{
    "name": "tpl/design-kit",
    "description": "Blade UI components and design tokens for TPL products",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Tpl\\DesignKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tpl\\DesignKit\\DesignKitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
